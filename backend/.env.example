# Cosmos DB for MongoDB (RU-based) - logs tecnicos e pedidos_canais_externos
# Pegue com o Bernardo, nunca commite o valor real. Formato:
# mongodb://<conta>:<chave>@<conta>.mongo.cosmos.azure.com:10255/?ssl=true&retrywrites=false
COSMOS_MONGO_CONNECTION_STRING=...

# Data Lake (ADLS Gen2) - usado pelo script de extracao (scripts/datalake/)
# Pegue com o Bernardo, nunca commite o valor real. Connection string da storage account
# (Portal Azure > storage account > Chaves de acesso > Cadeia de conexao).
DATALAKE_CONNECTION_STRING=...